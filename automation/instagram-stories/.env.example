# Página pública que contém a arte das notícias da VM.
STORY_PAGE_URL=https://vmmidias.com.br/VM/index.html?view=noticias
STORY_CHECK_INTERVAL_MINUTES=10
STORY_MAX_AGE_HOURS=48
STORY_MAX_PER_CYCLE=5
STORY_FIRST_RUN_MODE=latest

# false gera e salva as imagens sem publicar. Troque para true somente após o diagnóstico passar.
STORY_PUBLISH_ENABLED=false

# Storage privado usado apenas para entregar temporariamente a imagem à Meta.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=COLE_A_SERVICE_ROLE_APENAS_NESTE_ARQUIVO_LOCAL
SUPABASE_STORY_BUCKET=instagram-story-assets
STORY_SIGNED_URL_SECONDS=3600

# API oficial da Meta. Nunca use prefixo VITE_ nestas variáveis.
META_GRAPH_API_VERSION=vXX.X
META_INSTAGRAM_ACCOUNT_ID=ID_DA_CONTA_PROFISSIONAL
META_EXPECTED_USERNAME=radiobraba
META_ACCESS_TOKEN=TOKEN_DE_LONGA_DURACAO
